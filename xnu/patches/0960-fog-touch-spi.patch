+/*
+ * Read and parse FocalTech register 0x00..0x30 (49 bytes):
+ *   - buf[0x02]: point_num (bits [3:0] = number of active touch points)
+ *   - Finger records at offset 0x03 + 6 * i (i = 0..7):
+ *       rec[0]: [7:6] event_flag (0=Down, 1=Up, 2=Contact), [3:0] x[11:8]
+ *       rec[1]: x[7:0]
+ *       rec[2]: [7:4] touch_id (0..9), [3:0] y[11:8]
+ *       rec[3]: y[7:0]
+ *       rec[4]: weight / pressure
+ *       rec[5]: area
+ */
+static void
+sweet_touch_poll_focaltech(void)
+{
+    uint8_t buf[FTS_FRAME_READ_LEN];
+    bool active[TOUCH_MAX_FINGERS];
+    int  x_coords[TOUCH_MAX_FINGERS];
+    int  y_coords[TOUCH_MAX_FINGERS];
+
+    memset(buf, 0xFF, sizeof(buf));
+    if (fts_read_block(0x00U, buf, sizeof(buf)) != 0) {
+        return;
+    }
+
+    uint8_t point_num = buf[FTS_REG_POINT_NUM] & 0x0FU;
+
+    /* Ignore corrupt / unready 0xFF frames */
+    if (point_num == 0x0FU && buf[1] == 0xFFU && buf[3] == 0xFFU) {
+        return;
+    }
+
+    /* TD_STATUS == 0 means all fingers lifted */
+    if (point_num == 0) {
+        sweet_touch_release_all();
+        return;
+    }
+
+    if (point_num > TOUCH_MAX_FINGERS) {
+        return;
+    }
+
+    memset(active, 0, sizeof(active));
+    memset(x_coords, 0, sizeof(x_coords));
+    memset(y_coords, 0, sizeof(y_coords));
+
+    /* Registers 0x00..0x30 hold up to 7 complete 6-byte finger records (0x03..0x2C) */
+    int max_records = (int)((sizeof(buf) - FTS_REG_POINTS) / FTS_ONE_TCH_LEN);
+    for (int i = 0; i < max_records; i++) {
+        const uint8_t *rec = &buf[FTS_REG_POINTS + (i * FTS_ONE_TCH_LEN)];
+        uint8_t event_flag = (uint8_t)(rec[0] >> 6);
+        uint8_t touch_id   = (uint8_t)(rec[2] >> 4);
+
+        if (touch_id >= TOUCH_MAX_FINGERS) {
+            break;
+        }
+
+        uint32_t raw_x = (((uint32_t)rec[0] & 0x0FU) << 8) | (uint32_t)rec[1];
+        uint32_t raw_y = (((uint32_t)rec[2] & 0x0FU) << 8) | (uint32_t)rec[3];
+
+        if (event_flag == FTS_TOUCH_DOWN || event_flag == FTS_TOUCH_CONTACT) {
+            active[touch_id]   = true;
+            x_coords[touch_id] = touch_scale_coord(raw_x, g_touch.abs_x_max, TOUCH_SCREEN_WIDTH);
+            y_coords[touch_id] = touch_scale_coord(raw_y, g_touch.abs_y_max, TOUCH_SCREEN_HEIGHT);
+        }
+    }
+
+    sweet_touch_update_contacts(active, x_coords, y_coords);
+}
