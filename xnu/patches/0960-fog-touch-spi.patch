+static void
+nvt_set_page(uint32_t addr)
+{
+	spi_begin();
+	(void)spi_byte(0xff);
+	(void)spi_byte((uint8_t)(addr >> 15));
+	(void)spi_byte((uint8_t)(addr >> 7));
+	spi_end();
+}
+
+/* In the current page. CTP_SPI_WRITE: index with bit 7 set, then data. */
+static void
+nvt_put(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+	spi_begin();
+	(void)spi_byte((uint8_t)((addr & 0x7fu) | 0x80u));
+	for (uint32_t i = 0; i < len; ++i) {
+		(void)spi_byte(data[i]);
 	}
-	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
-	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
-		st.dead = true;
-		printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+	spi_end();
+}
+
+/* In the current page. CTP_SPI_READ: index with bit 7 clear, a dummy byte, then data. */
+static void
+nvt_get(uint32_t addr, uint8_t *data, uint32_t len)
+{
+	spi_begin();
+	(void)spi_byte((uint8_t)(addr & 0x7fu));
+	(void)spi_byte(0);
+	for (uint32_t i = 0; i < len; ++i) {
+		data[i] = spi_byte(0);
 	}
+	spi_end();
+}
+
+static void
+nvt_write_addr(uint32_t addr, uint8_t val)
+{
+	nvt_set_page(addr);
+	nvt_put(addr, &val, 1);
