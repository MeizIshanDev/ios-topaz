+/* ============================================================================
+ * Low-Level MMIO & Timing Helpers
+ * ============================================================================ */
+
+static inline uint32_t
+mmio_read32(volatile uintptr_t base, uint32_t offset)
+{
+    uint32_t val = *(volatile uint32_t *)(base + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return val;
+}
+
+static inline void
+mmio_write32(volatile uintptr_t base, uint32_t offset, uint32_t val)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(base + offset) = val;
+    __asm__ volatile("dmb osh" ::: "memory");
+}
+
+static inline void
+touch_udelay(uint32_t us)
+{
+    delay(us);
+}
+
+static inline void
+touch_msleep(uint32_t ms)
+{
+    if (ms == 0) {
+        return;
+    }
+    delay(ms * 1000U);
 }
 
