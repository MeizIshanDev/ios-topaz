+
+static inline int
+touch_scale_coord(uint32_t raw, uint32_t raw_max, uint32_t screen_max)
+{
+    if (raw_max == 0 || raw_max == screen_max) {
+        if (raw >= screen_max) {
+            return (int)(screen_max - 1);
+        }
+        return (int)raw;
+    }
+    uint32_t scaled = (raw * screen_max) / raw_max;
+    if (scaled >= screen_max) {
+        scaled = screen_max - 1;
+    }
+    return (int)scaled;
 }
 
