+/*
+ * Read and parse Novatek NT36525B 65-byte point buffer:
+ *   - Fast-read from offset 0x00 of EVENT_BUF_ADDR page:
+ *     nvt_spi_read(0x00, point_buf, 65) -> rx[2 + k] corresponds to Linux point_data[1 + k].
+ *   - Each of the 10 finger records is 6 bytes at offset (6 * i):
+ *       byte[0]: [7:3] finger_id (1..10), [2:0] status (0x01=enter, 0x02=moving, 0x03=release)
+ *       byte[1]: x[11:4]
+ *       byte[2]: y[11:4]
+ *       byte[3]: [7:4] x[3:0], [3:0] y[3:0]
+ *       byte[4]: width / area
+ *       byte[5]: pressure low byte
+ */
+static void
+sweet_touch_poll_novatek(void)
+{
+    uint8_t point_buf[NVT_POINT_DATA_LEN];
+    bool active[TOUCH_MAX_FINGERS];
+    int  x_coords[TOUCH_MAX_FINGERS];
+    int  y_coords[TOUCH_MAX_FINGERS];
+
+    memset(point_buf, 0, sizeof(point_buf));
+    if (nvt_spi_read(0x00U, point_buf, sizeof(point_buf)) != 0) {
+        return;
+    }
+
+    /* Guard against all-0xFF or all-0x00 bus error frames */
+    bool all_ff = true;
+    for (size_t i = 0; i < 12; i++) {
+        if (point_buf[i] != 0xFFU) {
+            all_ff = false;
+            break;
+        }
+    }
+    if (all_ff) {
+        /* Re-ensure XDATA page is set to EVENT_BUF_ADDR */
+        (void)nvt_set_page(g_touch.nvt_event_buf_addr);
+        return;
+    }
+
+    memset(active, 0, sizeof(active));
+    memset(x_coords, 0, sizeof(x_coords));
+    memset(y_coords, 0, sizeof(y_coords));
+
+    for (int i = 0; i < TOUCH_MAX_FINGERS; i++) {
+        const uint8_t *rec = &point_buf[6 * i];
+        uint8_t input_id   = (uint8_t)(rec[0] >> 3);
+        uint8_t status     = (uint8_t)(rec[0] & 0x07U);
+
+        if (input_id == 0 || input_id > TOUCH_MAX_FINGERS) {
+            continue;
+        }
+
+        if (status == 0x01U || status == 0x02U) {
+            uint32_t raw_x = ((uint32_t)rec[1] << 4) | ((uint32_t)(rec[3] >> 4) & 0x0FU);
+            uint32_t raw_y = ((uint32_t)rec[2] << 4) | ((uint32_t)rec[3] & 0x0FU);
+
+            if (raw_x > g_touch.abs_x_max || raw_y > g_touch.abs_y_max) {
+                continue;
+            }
+
+            int slot = (int)(input_id - 1);
+            active[slot]   = true;
+            x_coords[slot] = touch_scale_coord(raw_x, g_touch.abs_x_max, TOUCH_SCREEN_WIDTH);
+            y_coords[slot] = touch_scale_coord(raw_y, g_touch.abs_y_max, TOUCH_SCREEN_HEIGHT);
+        }
+    }
+
+    sweet_touch_update_contacts(active, x_coords, y_coords);
+}
